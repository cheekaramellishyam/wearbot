{
  "version": 2,
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api?__route__=$1"
    },
    {
      "source": "/privacy",
      "destination": "/api?__route__=privacy"
    },
    {
      "source": "/((?!api/|privacy).*)",
      "destination": "/index.html"
    }
  ]
}
